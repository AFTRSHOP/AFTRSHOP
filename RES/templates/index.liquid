{%- comment -%} The page keeps one semantic h1 while its editorial hero provides the visible headline. {%- endcomment -%}
<h1 class="sr-only">{{ shop.name | escape }}</h1>

{%- assign hero_image = images['aftr-after-dark-campaign.png'] | default: collections.all.products.first.featured_image -%}

{%- comment -%} Keep this source aligned with the homepage LCP preload in the layout. {%- endcomment -%}
{%
  block 'container',
  class: 'relative isolate min-h-[72svh] overflow-hidden md:min-h-[82svh]',
  background_image: hero_image,
  background_image_loading: 'eager',
  background_image_fetchpriority: 'high',
  background_image_sizes: '100vw',
  attributes: 'aria-labelledby="home-hero-heading"'
%}
  {%- unless hero_image -%}
    {% render 'placeholder-texture', kind: 'hero', seed: 1, class: 'absolute inset-0 aspect-auto -z-20' %}
  {%- endunless -%}

  <div class="pointer-events-none absolute inset-0 bg-linear-to-r from-overlay-strong via-overlay-subtle to-transparent"></div>

  <div class="relative flex min-h-[72svh] w-full max-w-page mx-auto flex-col items-start justify-center px-margin py-16 text-start text-interactive-text md:min-h-[82svh] md:py-24">
    {% block 'text', tag: 'p', variant: 'sm', class: 'mb-5 uppercase tracking-[0.28em] text-interactive-text' %}
      {{- 'home.hero.eyebrow' | t -}}
    {% endblock %}

    {% block 'heading', tag: 'h2', variant: '2xl', class: 'mb-4 max-w-4xl font-heading uppercase leading-[0.94] tracking-[-0.04em]', attributes: 'id="home-hero-heading"' %}
      {{- 'home.hero.title' | t -}}
    {% endblock %}

    {% block 'text', variant: 'lg', class: 'mb-8 max-w-prose text-interactive-text opacity-90' %}
      {{- 'home.hero.subtitle' | t -}}
    {% endblock %}

    {% block 'link', url: routes.all_products_collection_url, class: 'min-h-12 rounded-none bg-interactive px-7 font-heading text-sm font-semibold uppercase tracking-[0.16em] text-interactive-text no-underline hover:opacity-85' %}
      {{- 'home.hero.cta' | t -}}
    {% endblock %}
  </div>
{% endblock %}

{%- comment -%} The caller owns the collection source so the editor picker and rendered cards stay in sync. {%- endcomment -%}
{%- liquid
  assign featured_collection = collections.all
  assign featured_product_count = featured_collection.all_products_count | at_most: 12
  assign featured_eager_count = featured_product_count | at_most: 4
  assign featured_title = 'home.featured.title' | t
  assign featured_url = featured_collection.url | default: routes.all_products_collection_url
  assign featured_product_sizes = '(min-width: 1280px) 297px, (min-width: 1024px) calc((100vw - 92px) / 4), (min-width: 768px) calc((100vw - 84px) / 2), calc(100vw - 32px)'
-%}

{% block 'featured-collection', collection: featured_collection %}
  <div class="mb-6 flex items-end justify-between gap-4 px-margin max-w-page mx-auto md:mb-8">
    <div class="min-w-0">
      {% block 'text', tag: 'p', variant: 'sm', class: 'mb-2 uppercase tracking-[0.2em] text-on-surface-secondary' %}{{ 'home.featured.eyebrow' | t }}{% endblock %}
      {% block 'heading', tag: 'h2', variant: 'xl', class: 'font-heading uppercase tracking-wide' %}{{ featured_title }}{% endblock %}
    </div>
    {%- if featured_url != blank -%}
      {% block 'link', url: featured_url, class: 'shrink-0 text-sm uppercase tracking-[0.12em]' %}{{ 'collections.view_all' | t }}{% endblock %}
    {%- endif -%}
  </div>

  <div class="w-full max-w-page mx-auto px-margin contain-paint">
    {%- if featured_collection != blank and featured_collection.all_products_count > 0 -%}
      <ul role="list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-3 gap-y-10 stagger-fade-in">
        {% for product in featured_collection.products limit: featured_product_count %}
          <li>
            {%- if forloop.index <= featured_eager_count -%}{%- assign lazy_load = false -%}{%- assign fetch_priority = 'low' -%}{%- else -%}{%- assign lazy_load = true -%}{%- assign fetch_priority = 'auto' -%}{%- endif -%}
            <s-view-event class="block" view-event-trigger="intersect" view-event-payload="{{ product | standard_event_data: 'view', context: 'collection' | escape }}">
              {%- liquid
                assign card_variant = product.selected_or_first_available_variant
                if lazy_load
                  assign card_loading = 'lazy'
                else
                  assign card_loading = 'eager'
                endif
                assign card_image_attributes = 'loading="' | append: card_loading | append: '" fetchpriority="' | append: fetch_priority | append: '"'
              -%}
              {% block 'card', block.name: 't:blocks.product_card', url: product.url, aria_label: product.title, border_radius: 'rounded-card' %}
                <a href="{{ product.url | escape }}" class="relative block overflow-hidden rounded-[inherit]" aria-label="{{ product.title | escape }}">
                  {% block 'image', fallback_image: product.featured_image, aspect_ratio: 'aspect-square', sizes: featured_product_sizes, attributes: card_image_attributes, alt: product.title, seed: forloop.index %}{% endblock %}
                </a>
                <div class="flex flex-col gap-0.5 pt-2">
                  {% block 'text', variant: 'sm', tag: 'h3', class: 'font-medium text-on-surface line-clamp-2' %}{{ product.title | escape }}{% endblock %}
                  {% block 'price', price: card_variant.price, compare_at_price: card_variant.compare_at_price, price_min: product.price_min, price_max: product.price_max, class: 'text-sm font-medium self-start group-[.text-center]/card:self-center group-[.text-end]/card:self-end' %}{% endblock %}
                </div>
              {% endblock %}
            </s-view-event>
          </li>
        {% endfor %}
      </ul>
    {%- else -%}
      <ul role="list" class="grid grid-cols-2 md:grid-cols-4 gap-x-3 gap-y-6">
        {% for placeholder_index in (1..4) %}
          <li>
            {%- assign placeholder_title = 'product.placeholder_title' | t -%}
            {% block 'card', block.name: 't:blocks.product_card', url: routes.root_url, aria_label: placeholder_title, border_radius: 'rounded-card' %}
              <a href="{{ routes.root_url | escape }}" class="relative block overflow-hidden rounded-[inherit]" aria-label="{{ placeholder_title | escape }}">
                {% block 'image', aspect_ratio: 'aspect-square', sizes: featured_product_sizes, alt: placeholder_title, seed: placeholder_index %}{% endblock %}
              </a>
              <div class="pt-2">{% block 'text', variant: 'sm', tag: 'h3', class: 'font-medium text-on-surface line-clamp-2' %}{{ placeholder_title | escape }}{% endblock %}</div>
            {% endblock %}
          </li>
        {% endfor %}
      </ul>
    {%- endif -%}
  </div>
{% endblock %}

{% block 'container', class: 'border-y border-border bg-surface-secondary' %}
  <div class="mx-auto grid w-full max-w-page gap-8 px-margin py-16 md:grid-cols-2 md:items-end md:gap-12 md:py-24">
    <div>
      {% block 'text', tag: 'p', variant: 'sm', class: 'mb-4 uppercase tracking-[0.2em] text-accent' %}{{ 'home.story.eyebrow' | t }}{% endblock %}
      {% block 'heading', tag: 'h2', variant: '2xl', class: 'max-w-2xl font-heading uppercase leading-[0.95] tracking-[-0.03em]' %}{{ 'home.story.title' | t }}{% endblock %}
    </div>
    <div class="flex flex-col items-start gap-6">
      {% block 'text', variant: 'lg', class: 'max-w-prose text-on-surface-secondary' %}{{ 'home.story.body' | t }}{% endblock %}
      {% block 'link', url: routes.all_products_collection_url, class: 'uppercase tracking-[0.12em]' %}{{ 'home.story.cta' | t }}{% endblock %}
    </div>
  </div>
{% endblock %}
